# Canonical origin of the deployed site, without a trailing slash.
# Used for canonical URLs and Open Graph metadata. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Public URL that accepts contact-form submissions as a JSON POST.
# Leave unset until an approved form-processing service exists: while it is
# unset, /contact shows no form and states that online enquiries are not open.
# Must not contain a secret key (it is embedded in the browser bundle).
# Setting it also switches the Privacy Policy's form section — review that text first.
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
