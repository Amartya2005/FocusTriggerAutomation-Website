# Copy to .env.local (local) or set in the hosting provider's build settings (production).
# Both variables are read at BUILD time: change them, then rebuild and redeploy.

# REQUIRED FOR PRODUCTION. Canonical HTTPS origin of the live site, e.g. https://www.<your-domain>
# Drives canonical URLs, Open Graph/Twitter URLs, sitemap.xml, robots.txt and structured data.
# Unset = local development (falls back to http://localhost:3000; `next build` prints a warning).
# `npm run build:production` refuses to build without a real https domain.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL. Public HTTPS URL that accepts contact-form submissions as a JSON POST.
# Unset (current decision) = no form is shown; /contact offers the company email instead.
# Must not contain a secret key (it is embedded in the browser bundle). Its origin is
# added to the Content-Security-Policy connect-src at build time.
# Setting it also switches the Privacy Policy's form section — get that text reviewed first.
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
